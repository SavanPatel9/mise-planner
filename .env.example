# Postgres (Neon in prod, local or Neon branch in dev)
# DATABASE_URL: pooled connection (Neon "-pooler" host) for runtime queries
# DIRECT_URL: unpooled connection, used only by prisma migrate
DATABASE_URL=postgresql://user:password@localhost:5432/mise
DIRECT_URL=postgresql://user:password@localhost:5432/mise

# express-session cookie signing secret (generate: openssl rand -hex 32)
SESSION_SECRET=replace-with-random-hex

# Google OAuth (Cloud Console, app in testing mode)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Comma-separated emails allowed to sign in
ALLOWED_EMAILS=you@example.com

# AES-GCM key for OAuth tokens at rest (generate: openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=replace-with-base64-32-bytes

# Claude API (brain-dump parsing)
ANTHROPIC_API_KEY=sk-ant-replace-me

# Frontend origin for CORS + OAuth redirects
WEB_ORIGIN=http://localhost:5173

# API port (local dev)
PORT=3000

# Optional: override the Vite dev server's /api proxy target (default: http://localhost:3000)
VITE_API_PROXY_TARGET=http://localhost:3000
