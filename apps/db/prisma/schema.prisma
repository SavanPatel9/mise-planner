// Mise data model — see docs/spec.md for the narrative version.
// Conventions: userId on every user-owned table; createdAt/updatedAt everywhere;
// every FK indexed; onDelete explicit. The express-session store table is
// created by the create_user_sessions migration, owned at runtime by
// connect-pg-simple, and intentionally NOT modeled here (see prisma.config.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Unpooled connection: prisma migrate can't run through Neon's pooler.
  directUrl = env("DIRECT_URL")
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String?
  // IANA zone the "day" is measured in — the rollover boundary. UTC until
  // something sets it; `timezoneSource` says who did.
  timezone       String         @default("UTC")
  timezoneSource TimezoneSource @default(DETECTED)
  // Local calendar day the lazy rollover last ran for; null until the first one
  lastRolloverOn DateTime?      @db.Date
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tasks          Task[]
  sessions       Session[]
  integrations   Integration[]
  // dailyPlans   DailyPlan[] // restored in M6-T1
}

// How `User.timezone` got its value. Browser detection may fill a `DETECTED`
// zone on every sign-in; an `EXPLICIT` one was chosen in settings and detection
// must never overwrite it — travelling must not silently move the day boundary.
enum TimezoneSource {
  DETECTED
  EXPLICIT
}

model Task {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  project      String?
  estimateMin  Int?
  priority     Int              @default(2)
  dueAt        DateTime?
  status       TaskStatus       @default(TODO)
  source       TaskSource       @default(DUMP)
  deferCount   Int              @default(0) // times rolled to the next day
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessionTasks SessionTask[]
  segments     SessionSegment[]
  // planBlocks   PlanBlock[] // restored in M6-T1

  @@index([userId, status]) // task list: "my tasks by status"
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  DROPPED
}

enum TaskSource {
  DUMP
  GITHUB
  GMAIL
  OUTLOOK
  MANUAL
}

model Session {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedMin Int
  startedAt  DateTime
  endedAt    DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  tasks      SessionTask[]
  segments   SessionSegment[]

  @@index([userId, startedAt]) // end-of-day summary: a user's sessions for a date
}

// Which tasks were in a session, how each ended, and where I left off
model SessionTask {
  sessionId String
  taskId    String
  session   Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  outcome   TaskOutcome?
  note      String? // "where I left off", shown next session
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@id([sessionId, taskId])
  @@index([taskId])
}

enum TaskOutcome {
  DONE
  PARTIAL
  NOT_STARTED
}

// Time actually spent on each task within a session
model SessionSegment {
  id        String    @id @default(cuid())
  sessionId String
  taskId    String
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([sessionId])
  @@index([taskId])
}

