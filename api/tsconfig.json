{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The root package.json is CJS, but this entry (and the apps/api sources it
    // pulls in) is ESM — bundler resolution lets TS read it as ESM regardless
    // of the nearest package.json, matching how Vercel's esbuild builder
    // bundles it.
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  // This program reaches the apps/api sources through `index.ts`'s imports, so
  // a declaration file nothing imports — the `Express.User` augmentation —
  // would be left out and `req.user` would lose its shape. Listed explicitly;
  // apps/api's own tsconfig picks it up from `include: ["src"]`.
  "files": ["../apps/api/src/types/express.d.ts"],
  "include": ["."]
}
