{
  "name": "mise-planner",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "mise-planner",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/api": {
      "name": "@mise/api",
      "version": "0.0.0"
    },
    "apps/db": {
      "name": "@mise/db",
      "version": "0.0.0"
    },
    "apps/web": {
      "name": "@mise/web",
      "version": "0.0.0"
    },
    "node_modules/@mise/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@mise/db": {
      "resolved": "apps/db",
      "link": true
    },
    "node_modules/@mise/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@mise/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/shared": {
      "name": "@mise/shared",
      "version": "0.0.0",
      "devDependencies": {
        "typescript": "^5.9.3"
      }
    }
  }
}
