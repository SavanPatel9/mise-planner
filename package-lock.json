{
  "name": "mise-planner",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "mise-planner",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/api": {
      "name": "@mise/api",
      "version": "0.0.0"
    },
    "apps/db": {
      "name": "@mise/db",
      "version": "0.0.0"
    },
    "apps/web": {
      "name": "@mise/web",
      "version": "0.0.0"
    },
    "node_modules/@mise/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@mise/db": {
      "resolved": "apps/db",
      "link": true
    },
    "node_modules/@mise/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@mise/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/shared": {
      "name": "@mise/shared",
      "version": "0.0.0"
    }
  }
}
